# Local Homebrew Postgres on 5432:
DATABASE_URL=postgres://127.0.0.1:5432/trivia_photos

# Or Docker: docker compose -f server/docker-compose.yml up -d
# DATABASE_URL=postgres://trivia:trivia@127.0.0.1:5433/trivia

# Required in production. Send from the app as header X-Trivia-Pin.
UPLOAD_PIN=changeme

# Comma-separated browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:8787,http://localhost:8080,https://dsdev901.github.io

PORT=8787

# Serve the trivia frontend from this API (local all-in-one). Railway can leave this off.
SERVE_FRONTEND=1

# Optional. Used to read question/answer from photos. Anthropic first, else OpenAI.
# Without either key, the server tries local OCR (weaker on phone photos).
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# PARSE_MODEL=claude-haiku-4-5
